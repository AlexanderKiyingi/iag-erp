# iag-erp service configuration. Copy to repo-root .env for local dev; in prod
# these are injected by the platform (Railway). Only DATABASE_URL is strictly
# required; everything else has a sensible default (see internal/config/config.go).

# --- core ---
SERVICE_NAME=erp
ENVIRONMENT=development
PORT=4001
# HTTP_PORT is an alternate to PORT (PORT wins if both are set).
# HTTP_PORT=4001
LOG_LEVEL=info
APP_NAME=IAG Platform
DATABASE_URL=postgres://svc_iag_erp:iag_erp_dev@localhost:5432/iag_platform?sslmode=disable
# In production AUTO_MIGRATE MUST be false (migrations run out of band).
AUTO_MIGRATE=true

# --- auth (Bearer + audience trust model) ---
# AUTH_MODE must be jwt. Inbound tokens MUST carry AUDIENCE.
# The service-to-service token URL is derived as <JWT_ISSUER>/oauth/token.
AUTH_MODE=jwt
JWT_ISSUER=http://localhost:3001
JWKS_URL=http://localhost:3001/.well-known/jwks.json
AUDIENCE=iag.erp

# --- service-to-service credentials ---
# SERVICE_CLIENT_SECRET is REQUIRED in production and must be >= 16 characters.
SERVICE_CLIENT_ID=iag-erp
SERVICE_CLIENT_SECRET=iag-erp-dev-secret-change-me

# --- gateway ---
GATEWAY_API_PREFIX=/api/v1/erp

# --- browser CORS ---
# Canonical platform name (also accepted: CORS_ALLOW_ORIGIN, CORS_ORIGIN,
# ALLOWED_ORIGINS, CORS_ORIGINS). A "*" wildcard is rejected in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# --- kafka (operations events + notifications fan-out) ---
# Leave KAFKA_BROKERS blank to disable the event bus locally.
KAFKA_BROKERS=localhost:19092
KAFKA_CLIENT_ID=iag-erp
KAFKA_OPERATIONS_TOPIC=iag.operations
KAFKA_NOTIFICATIONS_TOPIC=iag.notifications
EVENT_BUS_ENABLED=true

# --- observability (optional) ---
# OTLP endpoint for traces/metrics; unset => telemetry export is disabled.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- HR birthday notifications (optional feature) ---
HR_BIRTHDAY_DEPARTMENT_CODE=HR
# Comma-separated recipients; unset => feature emits nothing.
# HR_BIRTHDAY_NOTIFY_EMAILS=hr-lead@iag.ug,people-ops@iag.ug

# --- work calendar ---
# Working weekdays as ISO numbers (1 = Monday ... 7 = Sunday). Leave is charged
# in working days, so this decides what a leave request costs and what the
# accrued-leave liability sent to finance is worth. Public holidays come from
# erp_setup_items rows of type 'holiday' and are maintained in the HR UI.
# Six-day week: 1,2,3,4,5,6
HR_WORK_WEEK=1,2,3,4,5

# What a new leave request is checked against.
#   entitlement — the whole year is available from 1 January (historical
#                 behaviour, and how most organisations actually operate)
#   accrual     — only what has been earned by the request date; stricter, and
#                 matches the obligation published to finance exactly
# GET /employees/:no/leave-balance always returns BOTH figures (remaining_days
# and balance_days) whichever is set; this only decides which one gates a booking.
HR_LEAVE_CHECK_BASIS=entitlement

# --- record-level access scoping (rollout flag, default off) ---
# When true, every HR endpoint is narrowed to the caller's own record and their
# reporting tree unless they hold erp.view_all_hr, and nobody may approve their
# own leave. Turning this on CHANGES WHAT EXISTING TOKENS CAN REACH: grant
# erp.view_all_hr to the hr-officer and hr-manager groups in iag-authentication
# first, and have those users refresh their token, or HR will find its own
# roster empty.
HR_SCOPE_ENFORCED=false

# --- payroll (default off) ---
# Exposes /api/v1/payroll/*. Payroll computes PAYE and NSSF against live pay
# data using the bands seeded in migration 010; confirm those against the
# current URA schedule before enabling anywhere real. Permissions are split:
# erp.run_payroll computes, erp.approve_payroll approves (never the preparer),
# erp.post_payroll releases to the ledger.
PAYROLL_ENABLED=false
